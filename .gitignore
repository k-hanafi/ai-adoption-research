# ═══════════════════════════════════════════════════════════════════════════
# AI-Enablement Deep Research Agent - Git Ignore
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Environment & Secrets
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ─────────────────────────────────────────────────────────────────────────────
# Credentials folder (track templates, ignore actual keys)
# ─────────────────────────────────────────────────────────────────────────────
credentials/*.txt
!credentials/*.txt.template

# ─────────────────────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/

# ─────────────────────────────────────────────────────────────────────────────
# IDE
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# Output files (keep .gitkeep, ignore actual outputs)
# ─────────────────────────────────────────────────────────────────────────────
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.jsonl
outputs/**/*.log
outputs/**/*.html
outputs/**/latest
!outputs/.gitkeep
!outputs/evals/runs/.gitkeep
logs/*.log
checkpoints/*.json
# January to March 2026 decks.
presentation/*.html
# Legacy presentation archive (superseded by evals/instances/)
presentation/eval_instances/catalog.json
presentation/eval_instances/index.html
!presentation/eval_instances/.gitkeep
# Standalone eval archive + run bundles (keep .gitkeep only)
evals/instances/**
!evals/instances/.gitkeep
evals/runs/**
!evals/runs/.gitkeep
# Frozen March dump for panel rebuilds (~69MB). Local only.
evals/references/*.jsonl
evals/references/*.csv
!evals/references/.gitkeep
!evals/references/README.md
# Licensed Crunchbase dumps (local only). Schema samples stay in git.
crunchbase_data/*.csv
crunchbase_data/*.jsonl
!crunchbase_data/sample/
!crunchbase_data/sample/**

# Upcoming v2 production writes (PR2)
outputs/prod/**
!outputs/prod/sample/
!outputs/prod/sample/**
outputs/stage3/**

.cursor/plans/

# ─────────────────────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
